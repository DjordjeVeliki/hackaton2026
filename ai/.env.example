# Cuevia AI service (ai/) - server-only settings. Copy to ai/.env; never commit the real file.

# Shared secret the backend sends as X-Internal-Token. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=

# Text inference provider: openai_compatible | google
#  - openai_compatible: any OpenAI-compatible server serving a Gemma model (verified: Ollama /v1)
#  - google: Google Generative Language API (hosted Gemma, e.g. gemma-3-27b-it)
GEMMA_PROVIDER=openai_compatible
GEMMA_API_KEY=
# Must be a Gemma-family id; anything else is refused. Examples: gemma4:e2b (Ollama), gemma-3-27b-it (google)
GEMMA_MODEL=gemma4:e2b
# openai_compatible only. Local Ollama: http://localhost:11434/v1 (from Docker: http://host.docker.internal:11434/v1)
GEMMA_API_BASE_URL=http://localhost:11434/v1

# Audio transcription: disabled | openai_compatible (separate audio-capable Gemma endpoint)
# Verified: Ollama >= 0.30.9 + gemma4:e2b / gemma4:e4b declare the "audio" capability.
GEMMA_ASR_MODE=disabled
GEMMA_ASR_MODEL=gemma4:e2b
GEMMA_ASR_ENDPOINT=http://localhost:11434/v1
GEMMA_ASR_API_KEY=

# Not used by the current providers (Ollama pulls gemma4 without it). Reserved for a future
# Hugging Face transformers Gemma provider that would need gated weights.
HF_TOKEN=

# Optional: raw Brave Web Search for /explain sources. Unset -> provided/general mode only.
BRAVE_SEARCH_API_KEY=

# Optional tuning (defaults shown)
# GEMMA_TIMEOUT_SECONDS=120
# GEMMA_MAX_OUTPUT_TOKENS=1024
# GEMMA_MAX_CONCURRENCY=2
# GEMMA_JSON_MODE=true          # send response_format=json_object (openai_compatible)
# GEMMA_DISABLE_THINKING=true   # send reasoning_effort=none; thinking text is never retained
# GEMMA_ASR_MAX_SECONDS=30
# GEMMA_ASR_MAX_BYTES=10485760
# AI_BIND_HOST=127.0.0.1        # Docker image sets 0.0.0.0
# LOG_LEVEL=INFO
